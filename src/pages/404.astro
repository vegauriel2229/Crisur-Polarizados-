---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import ServiceArt from '../components/ServiceArt.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { WHATSAPP_CTA_LABELS } from '../data/cta';
import { siteSettings } from '../config/site';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const whatsappUrl = buildWhatsAppUrl(siteSettings.whatsappNumber, siteSettings.whatsappDefaultMessage).href;
---

<BaseLayout title={`Página no encontrada | ${siteSettings.businessName}`} description="La página que buscás no existe.">
  <SiteHeader whatsappUrl={whatsappUrl} />
  <main class="not-found">
    <!-- Un vidrio a medio polarizar: lo que buscabas quedó del otro lado. -->
    <div class="art" aria-hidden="true"><ServiceArt service="negocios" uid="not-found" /></div>
    <h1>Esta página no existe</h1>
    <p>Puede que el link esté mal escrito o que la página se haya movido.</p>
    <div class="actions">
      <WhatsAppButton href={whatsappUrl} label={WHATSAPP_CTA_LABELS.general} variant="primary" class="action" />
      <a class="button button-secondary action" href="/">Ir al inicio</a>
    </div>
    <p>¿Dónde querés colocar la lámina?</p>
    <nav class="links" aria-label="Servicios">
      <a class="button button-secondary" href="/autos/">Autos</a>
      <a class="button button-secondary" href="/hogares/">Hogares</a>
      <a class="button button-secondary" href="/negocios/">Negocios</a>
    </nav>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 40rem;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) 1.25rem clamp(4rem, 10vw, 7rem);
    text-align: center;
  }
  .art {
    --film: 0.55;
    width: min(24rem, 90%);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-surface);
    background: var(--art-backdrop);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  h1 {
    margin-top: 1rem;
    font-stretch: 118%;
    font-weight: 780;
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  p {
    max-width: 44ch;
    color: var(--color-ink-muted);
  }
  .actions,
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  @media (max-width: 520px) {
    .actions {
      width: 100%;
      max-width: 22rem;
    }
    .action {
      width: 100%;
    }
  }
</style>
