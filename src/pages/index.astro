---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import WhatsAppFab from '../components/layout/WhatsAppFab.astro';
import HomeHero from '../components/home/HomeHero.astro';
import AboutSection from '../components/home/AboutSection.astro';
import FilmTypesSection from '../components/home/FilmTypesSection.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import HomeFaqSection from '../components/home/HomeFaqSection.astro';
import { siteSettings } from '../config/site';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const defaultWhatsappUrl = buildWhatsAppUrl(siteSettings.whatsappNumber, siteSettings.whatsappDefaultMessage).href;
---

<BaseLayout
  title={`${siteSettings.businessName} | Polarizado de autos, hogares y negocios en ${siteSettings.serviceArea}`}
  description={`Polarizado, espejado, esmerilado y láminas de seguridad para autos, hogares y negocios. Más de ${siteSettings.yearsOfExperience} años en ${siteSettings.serviceArea}. Consultá por WhatsApp.`}
>
  <main>
    <HomeHero whatsappUrl={defaultWhatsappUrl}>
      <SiteHeader slot="header" whatsappUrl={defaultWhatsappUrl} />
    </HomeHero>
    <AboutSection whatsappUrl={defaultWhatsappUrl} />
    <FilmTypesSection whatsappUrl={defaultWhatsappUrl} />
    <ProcessSection whatsappUrl={defaultWhatsappUrl} />
    <HomeFaqSection />
  </main>
  <SiteFooter />
  <WhatsAppFab href={defaultWhatsappUrl} label="Consultar por WhatsApp" />
</BaseLayout>
