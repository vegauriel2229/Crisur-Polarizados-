---
import { PROCESS_STEPS } from '../../data/home';
import WhatsAppButton from '../WhatsAppButton.astro';
import { WHATSAPP_CTA_LABELS } from '../../data/cta';

interface Props {
  /** URL con el mensaje general (whatsappDefaultMessage), armada en index.astro (T3, D-005). */
  whatsappUrl: string;
}

const { whatsappUrl } = Astro.props;
---

<section class="process" aria-labelledby="process-title">
  <div class="process-inner">
    <h2 id="process-title">Cómo trabajamos</h2>
    <!-- Es una secuencia real (de la consulta a la colocación): los números informan el orden. -->
    <ol class="steps">
      {
        PROCESS_STEPS.map((step, index) => (
          <li class="step">
            <span class="step-number" aria-hidden="true">
              {index + 1}
            </span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
    <WhatsAppButton href={whatsappUrl} label={WHATSAPP_CTA_LABELS.general} variant="secondary" class="section-cta" />
  </div>
</section>

<style>
  .process {
    padding: clamp(4rem, 9vw, 7rem) clamp(1rem, 4vw, 2.5rem);
    border-top: 1px solid var(--color-line);
  }
  .process-inner {
    max-width: 76rem;
    margin: 0 auto;
  }
  h2 {
    max-width: 14ch;
    font-stretch: 118%;
    font-weight: 780;
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .steps {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    list-style: none;
    counter-reset: none;
  }
  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
  .step {
    position: relative;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .step-number {
    display: block;
    font-stretch: var(--font-display-stretch);
    font-weight: var(--font-display-weight);
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin-top: 0.9rem;
    font-stretch: 112%;
    font-weight: 750;
    font-size: 1.15rem;
  }
  p {
    margin-top: 0.4rem;
    max-width: 32ch;
    color: var(--color-ink-muted);
  }
  .section-cta {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  @media (max-width: 520px) {
    .section-cta {
      width: 100%;
      max-width: 22rem;
    }
  }
</style>
