---
import type { HTMLAttributes } from 'astro/types';
import type { BenefitKind } from '../data/services';

export type IconName = 'whatsapp' | 'instagram' | BenefitKind;

interface Props extends HTMLAttributes<'svg'> {
  name: IconName;
}

// `...rest` lleva el atributo de estilos con scope del componente padre: así el padre puede darle tamaño/color.
const { name, class: className, ...rest } = Astro.props;
const isSolid = name === 'whatsapp';
---

<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class:list={['icon', { 'icon-solid': isSolid }, className]} {...rest}>
  {
    name === 'whatsapp' && (
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.3" cy="6.7" r="1" class="dot" />
      </>
    )
  }
  {
    /* Termómetro: menos calor. */
    name === 'heat' && (
      <>
        <path d="M10 13.5V5a2 2 0 1 1 4 0v8.5a4 4 0 1 1-4 0Z" />
        <path d="M12 9v7" />
      </>
    )
  }
  {
    /* Ojo tachado: privacidad. */
    name === 'privacy' && (
      <>
        <path d="M3 12s3.2-6 9-6c1.6 0 3 .45 4.2 1.1M21 12s-3.2 6-9 6c-1.6 0-3-.45-4.2-1.1" />
        <path d="M9.9 14.1a3 3 0 0 1 4.2-4.2" />
        <path d="m4 20 16-16" />
      </>
    )
  }
  {
    /* Sol: radiación UV. */
    name === 'uv' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
      </>
    )
  }
  {
    /* Escudo: láminas de seguridad. */
    name === 'security' && (
      <>
        <path d="M12 3 19 6v5.5c0 4.4-2.9 7.7-7 9.5-4.1-1.8-7-5.1-7-9.5V6Z" />
        <path d="m9 12 2.2 2.2L15.5 10" />
      </>
    )
  }
</svg>

<style>
  .icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-solid {
    fill: currentColor;
    stroke: none;
  }
  .dot {
    fill: currentColor;
    stroke: none;
  }
</style>
