---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo.jpeg';
import Icon from '../Icon.astro';
import ServiceArt from '../ServiceArt.astro';
import { describeTreatments, type Service, type ServiceId } from '../../data/services';
import { buildWhatsAppUrl } from '../../lib/whatsapp';

interface Props {
  services: readonly Service[];
  initial: ServiceId;
  whatsappNumber: string;
  defaultWhatsappMessage: string;
  instagramUrl: string;
}

const { services, initial, whatsappNumber, defaultWhatsappMessage, instagramUrl } = Astro.props;

// El selector tiene una ventana al centro y dos a los costados: exactamente 3 servicios (fail-fast en build).
const initialIndex = services.findIndex((service) => service.id === initial);
if (services.length !== 3 || initialIndex === -1) {
  throw new Error(`ServiceHero requires exactly 3 services including "${initial}".`);
}

const whatsappUrls = Object.fromEntries(
  services.map((service) => [service.id, buildWhatsAppUrl(whatsappNumber, service.whatsappMessage).href]),
) as Record<ServiceId, string>;
const config = {
  order: services.map((service) => service.id),
  initial,
  whatsappUrls,
  labels: Object.fromEntries(services.map((service) => [service.id, service.navLabel])),
};
const defaultWhatsappUrl = buildWhatsAppUrl(whatsappNumber, defaultWhatsappMessage).href;

/** Misma cuenta que hero-controller.ts: 0 = centro, 1 = derecha, 2 = izquierda. */
const positionOf = (index: number): 'left' | 'center' | 'right' => {
  const offset = (index - initialIndex + services.length) % services.length;
  return offset === 0 ? 'center' : offset === 1 ? 'right' : 'left';
};
---

<section class="stage" data-service-hero data-config={JSON.stringify(config)} aria-label="Servicios de Crisur Polarizados">
  <header class="site-header">
    <a class="brand" href="/" aria-label="Crisur Polarizados, inicio">
      <Image src={logo} alt="" width={96} class="brand-mark" loading="eager" />
      <span class="brand-name">crisur</span>
      <span class="brand-suffix">polarizados</span>
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Servicios">
      {
        services.map((service) => (
          <a href={`#${service.id}`} data-nav-service={service.id} aria-current={service.id === initial ? 'true' : undefined}>
            {service.navLabel}
          </a>
        ))
      }
      <a class="nav-icon" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram de Crisur">
        <Icon name="instagram" class="nav-icon-svg" />
        <span class="nav-icon-label">Instagram</span>
      </a>
      <a class="nav-cta" href={defaultWhatsappUrl} target="_blank" rel="noopener noreferrer">Consultar</a>
    </nav>
    <button class="burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- Panel que controla el selector: los 3 textos existen en el HTML y se muestra el activo. -->
  <div class="copy" id="hero-copy" role="tabpanel" aria-labelledby={`tab-${initial}`}>
    <h1 class="headline">
      {
        services.map((service) => (
          <span class:list={['variant', { 'is-active': service.id === initial }]} data-variant={service.id}>
            <span class="title-prefix">{service.hero.titlePrefix}</span>
            <span class="title" style={`--title-chars:${service.hero.title.length}`}>
              {service.hero.title}
            </span>
          </span>
        ))
      }
    </h1>
    <div class="lede-stack">
      {
        services.map((service) => (
          <p class:list={['lede', 'variant', { 'is-active': service.id === initial }]} data-variant={service.id}>
            {service.hero.lede}
          </p>
        ))
      }
    </div>
    <div class="actions">
      <a class="button button-primary" data-cta href={whatsappUrls[initial]} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" />
        <span>Consultar por WhatsApp</span>
      </a>
      <a class="button button-secondary" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Ver trabajos en Instagram">
        <Icon name="instagram" />
        <span>Ver trabajos</span>
      </a>
    </div>
  </div>

  <!--
    SELECTOR ("ruleta"): las 3 ventanas están apiladas en la misma celda de grid.
    Su lugar (izquierda / centro / derecha) lo decide el atributo data-pos, que
    hero-controller.ts actualiza; el CSS de abajo convierte data-pos en movimiento.
  -->
  <div class="selector" role="tablist" aria-label="Elegí qué querés polarizar" data-selector>
    {
      services.map((service, index) => (
        <button
          class="pane"
          type="button"
          role="tab"
          id={`tab-${service.id}`}
          aria-controls="hero-copy"
          aria-selected={service.id === initial ? 'true' : 'false'}
          tabindex={service.id === initial ? 0 : -1}
          data-select={service.id}
          data-pos={positionOf(index)}
        >
          <span class="pane-window">
            {service.photo ? (
              /* FOTO REAL: se completa desde src/data/services.ts (campo `photo`); acá no hay que tocar nada. */
              <Image src={service.photo.src} alt="" widths={[480, 960]} sizes="(max-width: 700px) 74vw, 27rem" class="pane-photo" />
            ) : (
              <ServiceArt service={service.id} uid={`hero-${service.id}`} />
            )}
          </span>
          <span class="pane-caption">
            <span class="pane-name">{service.navLabel}</span>
            <span class="pane-treatments">{describeTreatments(service.treatments)}</span>
          </span>
        </button>
      ))
    }
  </div>
  <p class="sr-only" aria-live="polite" data-live></p>
</section>

<script>
  import './hero-controller';
</script>

<style>
  .stage {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: max(100svh, 640px);
    overflow: hidden;
    /* Fondo: grafito con una luz fría arriba. La luz roja vive pegada a la ventana destacada (.selector::before). */
    background:
      radial-gradient(ellipse 80% 55% at 50% 0%, var(--color-cool-light), transparent 70%),
      linear-gradient(180deg, var(--color-bg) 0%, #0e1116 62%, #0a0c10 100%);
  }
  /* Tablet vertical: la pantalla es más alta que el contenido; el hero no se estira y la sección siguiente asoma. */
  @media (min-width: 600px) and (max-aspect-ratio: 4/5) {
    .stage {
      min-height: auto;
    }
  }

  /* ── Header ─────────────────────────────────────────── */
  .site-header {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.5rem;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--color-line);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-ink);
    text-decoration: none;
    line-height: 1;
  }
  .brand :global(.brand-mark) {
    width: 2.5rem;
    height: 2.5rem;
    margin-right: 0.2rem;
    object-fit: cover;
    border-radius: 50%;
    clip-path: circle(48%);
  }
  .brand-name {
    font-stretch: var(--font-display-stretch);
    font-weight: var(--font-display-weight);
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }
  .brand-suffix {
    font-size: 1rem;
    font-weight: 450;
    color: var(--color-ink-muted);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.95rem;
    border-radius: var(--radius-control);
    color: var(--color-ink-muted);
    font-weight: 550;
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .site-nav a:hover {
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.05);
  }
  .site-nav a[aria-current='true'] {
    color: var(--color-ink);
  }
  .site-nav a[aria-current='true']::after {
    content: '';
    position: absolute;
    left: 0.95rem;
    right: 0.95rem;
    bottom: 0.35rem;
    height: 2px;
    border-radius: var(--radius-hairline);
    background: var(--color-brand-red);
  }
  .site-nav .nav-icon {
    width: 2.75rem;
    justify-content: center;
    padding: 0;
  }
  .nav-icon-label {
    display: none;
  }
  .site-nav .nav-cta {
    margin-left: 0.5rem;
    padding: 0 1.2rem;
    min-height: 2.5rem;
    background: var(--color-cta);
    color: var(--color-on-red);
    font-weight: 650;
  }
  .site-nav .nav-cta:hover {
    background: var(--color-cta-hover);
    color: var(--color-on-red);
  }

  .burger {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .burger span {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: var(--radius-hairline);
    background: var(--color-ink);
    transition:
      transform 0.28s var(--ease-in-out),
      opacity 0.18s linear;
  }
  .site-header[data-open='true'] .burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header[data-open='true'] .burger span:nth-child(2) {
    opacity: 0;
  }
  .site-header[data-open='true'] .burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Copy ───────────────────────────────────────────── */
  .copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(1.5rem, 5svh, 3.5rem) 1.25rem 0;
    text-align: center;
  }
  /*
   * Los 3 textos comparten la misma celda de grid (grid-area 1 / 1): el bloque
   * siempre mide lo que mide el texto más alto, así la página no "salta" al cambiar.
   */
  .headline,
  .lede-stack {
    display: grid;
  }
  .headline .variant,
  .lede-stack .variant {
    grid-area: 1 / 1;
  }
  .headline .variant {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
  }
  /*
   * Crossfade del texto: el que se va se desvanece, baja y se desenfoca; el que llega
   * hace lo contrario con 0.1s de retraso. `visibility` cambia al final de la salida
   * para que los lectores de pantalla y el mouse ignoren los textos ocultos.
   */
  .variant {
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    filter: blur(6px);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.6s var(--ease-out),
      filter 0.4s var(--ease-out),
      visibility 0s linear 0.4s;
  }
  .variant.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    filter: none;
    transition-delay: 0.1s, 0.1s, 0.1s, 0s;
  }
  /* Primera línea del título: mismo color y familia que la palabra grande, un escalón más chica. */
  .title-prefix {
    font-stretch: 110%;
    font-weight: 650;
    font-size: clamp(1.3rem, 0.95rem + 1.5vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .title {
    font-stretch: var(--font-display-stretch);
    font-weight: var(--font-display-weight);
    /* Escala según largo ("HOGARES" no desborda donde "AUTOS" entra holgado) y según alto de pantalla. */
    font-size: min(6rem, 11svh, calc((100vw - 2.5rem) / (var(--title-chars) * 0.9)));
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .lede-stack {
    max-width: 40rem;
    margin-top: clamp(0.8rem, 2svh, 1.3rem);
  }
  .lede {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: clamp(1rem, 2.6svh, 1.75rem);
  }
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0 1.5rem;
    overflow: hidden;
    border-radius: var(--radius-control);
    font-size: 1rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      background-color 0.2s,
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .button-primary {
    background: var(--color-cta);
    color: var(--color-on-red);
    box-shadow:
      0 12px 28px -12px rgba(227, 38, 43, 0.75),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }
  /* Brillo que cruza el botón al pasar el mouse: el mismo gesto que la espátula sobre el vidrio. */
  .button-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.28) 50%, transparent 65%);
    transform: translateX(-120%);
    transition: transform 0.7s var(--ease-out);
  }
  .button-primary:hover {
    background: var(--color-cta-hover);
    transform: translateY(-1px);
    box-shadow:
      0 16px 32px -12px rgba(227, 38, 43, 0.85),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }
  .button-primary:hover::after {
    transform: translateX(120%);
  }
  .button-secondary {
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .button-secondary:hover {
    background: rgba(255, 255, 255, 0.09);
    transform: translateY(-1px);
  }
  .button:active {
    transform: translateY(0) scale(0.98);
  }

  /* ── Selector de ventanas ───────────────────────────── */
  .selector {
    --pane-w: min(31rem, 34vw, 46svh);
    /* Distancia del centro a cada ventana lateral. */
    --pane-offset: calc(var(--pane-w) * 0.98);
    --side-scale: 0.74;
    position: relative;
    flex: 1 0 auto;
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 3.5svh, 2.75rem) 0 clamp(1.5rem, 4svh, 3rem);
    /* El navegador sigue haciendo scroll vertical; el swipe horizontal lo maneja hero-controller.ts. */
    touch-action: pan-y;
  }
  /*
   * Luz roja DETRÁS de la ventana destacada: comparte la celda de grid con las ventanas
   * (grid-area 1 / 1), así queda centrada con ella en cualquier pantalla. Como está detrás,
   * el backdrop-filter del marco la difumina: el vidrio se "ilumina" de rojo desde atrás.
   */
  .selector::before {
    content: '';
    grid-area: 1 / 1;
    z-index: 0;
    width: calc(var(--pane-w) * 1.35);
    height: calc(var(--pane-w) * 0.6);
    translate: 0 30%;
    background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(227, 38, 43, 0.5), transparent 72%);
    pointer-events: none;
  }

  .pane {
    /* 0 = sin lámina. La ventana del centro la sube a 1 (ver más abajo). */
    --film: 0;
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: var(--pane-w);
    padding: 0.55rem 0.55rem 0.8rem;
    border: 0;
    border-radius: 20px;
    color: var(--color-ink);
    font: inherit;
    text-align: center;
    cursor: pointer;
    /*
     * Glassmorphism con sentido: el marco ES un vidrio. Fondo translúcido + blur del
     * fondo que queda detrás (la luz roja) + un filo de luz arriba (inset).
     */
    background: linear-gradient(155deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.03) 46%, rgba(255, 255, 255, 0.06));
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 0 0 1px rgba(255, 255, 255, 0.07),
      0 36px 60px -36px rgba(0, 0, 0, 0.9);
    /*
     * El movimiento de la ruleta: cuando cambia data-pos, cambian transform y filter,
     * y estas transiciones los interpolan. --film también transiciona (0.4s) para que la
     * ventana que deja el centro "despegue" su lámina mientras se corre.
     */
    transition:
      transform 0.8s var(--ease-out),
      filter 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out),
      --film 0.4s var(--ease-in-out);
  }

  /* Posiciones: el mismo punto de partida (centro de la celda) desplazado y achicado. */
  .pane[data-pos='left'] {
    z-index: 1;
    transform: translateX(calc(var(--pane-offset) * -1)) scale(var(--side-scale));
    filter: brightness(0.55) saturate(0.7);
  }
  .pane[data-pos='right'] {
    z-index: 1;
    transform: translateX(var(--pane-offset)) scale(var(--side-scale));
    filter: brightness(0.55) saturate(0.7);
  }
  .pane[data-pos='center'] {
    --film: 1;
    z-index: 2;
    cursor: default;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      0 40px 70px -34px rgba(227, 38, 43, 0.5);
  }
  .pane[data-pos='left']:hover,
  .pane[data-pos='right']:hover {
    filter: brightness(0.78) saturate(0.9);
  }

  .pane-window {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 14px;
    /*
     * FOTO REAL (alternativa por CSS): si preferís una foto de fondo en vez de <Image>,
     * reemplazá este degradé por:  background: url('/fotos/autos.jpg') center / cover;
     * (la ruta es de la carpeta public/). Lo recomendado es el campo `photo` de services.ts,
     * que optimiza la imagen automáticamente.
     */
    background: var(--art-backdrop);
  }
  .pane-window :global(.pane-photo) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pane-caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    transition: opacity 0.4s var(--ease-out);
  }
  .pane-name {
    font-stretch: 112%;
    font-weight: 750;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .pane-treatments {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    transition: opacity 0.4s var(--ease-out);
  }
  /* Achicadas al 74 % la línea de láminas quedaría ilegible: en los costados solo se ve el nombre. */
  .pane:not([data-pos='center']) .pane-treatments {
    opacity: 0;
  }

  /* ── Mobile ─────────────────────────────────────────── */
  @media (max-width: 880px) {
    .site-header {
      height: 4rem;
    }
    .burger {
      display: flex;
    }
    .site-nav {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 1rem;
      left: 1rem;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      padding: 0.75rem;
      border-radius: var(--radius-surface);
      background: var(--color-surface);
      box-shadow:
        0 24px 48px -12px rgba(0, 0, 0, 0.6),
        inset 0 0 0 1px var(--color-line);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 0.22s ease,
        transform 0.28s var(--ease-out),
        visibility 0s linear 0.28s;
    }
    .site-header[data-open='true'] .site-nav {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
    .site-nav a {
      min-height: 3rem;
      padding: 0 1rem;
      font-size: 1.05rem;
      color: var(--color-ink);
    }
    .site-nav a[aria-current='true']::after {
      left: 1rem;
      right: auto;
      width: 1.5rem;
      bottom: 0.45rem;
    }
    .site-nav .nav-icon {
      width: auto;
      justify-content: flex-start;
      gap: 0.6rem;
      padding: 0 1rem;
    }
    .nav-icon-label {
      display: inline;
    }
    .site-nav .nav-cta {
      margin: 0.5rem 0 0;
      justify-content: center;
      min-height: 3rem;
    }
  }

  /* Tablet y celular: la ventana central ocupa casi todo el ancho y las laterales asoman desde los bordes. */
  @media (max-width: 880px) {
    .selector {
      --pane-w: min(74vw, 27rem, 46svh);
      --pane-offset: calc(var(--pane-w) * 0.9);
    }
    /* De las laterales solo asoma el dibujo: un texto cortado por el borde se lee como error. */
    .pane:not([data-pos='center']) .pane-caption {
      opacity: 0;
    }
  }

  @media (max-width: 520px) {
    .actions {
      width: 100%;
      max-width: 22rem;
    }
    .button {
      flex: 1 1 100%;
    }
    .button-secondary {
      min-height: 2.75rem;
      background: none;
      box-shadow: none;
    }
    .brand-suffix {
      display: none;
    }
  }

  /* ── Entrada: un único momento orquestado ───────────── */
  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      animation: hero-fade 0.9s ease 0.05s both;
    }
    .headline .variant.is-active .title-prefix {
      animation: hero-rise 0.9s var(--ease-out) 0.08s both;
    }
    .headline .variant.is-active .title {
      animation: hero-rise 1s var(--ease-out) 0.16s both;
    }
    .lede-stack {
      animation: hero-rise 0.9s var(--ease-out) 0.3s both;
    }
    .actions {
      animation: hero-rise 0.9s var(--ease-out) 0.42s both;
    }
    /*
     * Las ventanas suben con `translate` (propiedad aparte de `transform`), así la
