---
import { Image } from 'astro:assets';
import type { GalleryPhoto } from '../../data/gallery';
import type { Service } from '../../data/services';

interface Props {
  service: Service;
  photos: readonly GalleryPhoto[];
}

const { service, photos } = Astro.props;
const serviceName = service.navLabel.toLowerCase();
---

<section class="gallery" aria-labelledby="gallery-title" data-gallery>
  <header class="gallery-head">
    <h2 id="gallery-title">Trabajos en {serviceName}</h2>
    {
      photos.length > 1 && (
        <div class="gallery-controls">
          <button class="gallery-button" type="button" data-gallery-prev aria-label="Foto anterior">
            <span class="chevron chevron-left" aria-hidden="true" />
          </button>
          <button class="gallery-button" type="button" data-gallery-next aria-label="Foto siguiente">
            <span class="chevron chevron-right" aria-hidden="true" />
          </button>
        </div>
      )
    }
  </header>

  {/* Carrusel nativo (scroll-snap): funciona con swipe, rueda y teclado aunque el JS no cargue. */}
  <ul class="gallery-track" tabindex="0" aria-label={`Fotos de trabajos en ${serviceName}`} data-gallery-track>
    {photos.map((photo, index) => (
      <li class="gallery-item">
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[480, 960]}
          sizes="(min-width: 900px) 30rem, 82vw"
          loading={index < 2 ? 'eager' : 'lazy'}
          class="gallery-photo"
        />
      </li>
    ))}
  </ul>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
    if (track === null) return;
    const scrollByItem = (direction: 1 | -1): void => {
      const item = track.querySelector<HTMLElement>('.gallery-item');
      const step = item === null ? track.clientWidth : item.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0');
      const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      track.scrollBy({ left: step * direction, behavior });
    };
    gallery.querySelector('[data-gallery-prev]')?.addEventListener('click', () => scrollByItem(-1));
    gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => scrollByItem(1));
  });
</script>

<style>
  .gallery {
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(4.5rem, 10vw, 7rem) clamp(1rem, 4vw, 2.5rem) 0;
  }
  .gallery-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  h2 {
    max-width: 14ch;
    font-stretch: 118%;
    font-weight: 780;
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .gallery-controls {
    display: flex;
    gap: 0.5rem;
  }
  .gallery-button {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: var(--radius-control);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px var(--color-line);
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .gallery-button:hover {
    background: rgba(255, 255, 255, 0.09);
  }
  .chevron {
    width: 0.6rem;
    height: 0.6rem;
    border-right: 1.8px solid currentColor;
    border-bottom: 1.8px solid currentColor;
  }
  .chevron-left {
    transform: translateX(2px) rotate(135deg);
  }
  .chevron-right {
    transform: translateX(-2px) rotate(-45deg);
  }

  .gallery-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(30rem, 82vw);
    gap: 1.25rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    padding-bottom: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    list-style: none;
    border-radius: var(--radius-surface);
  }
  .gallery-item {
    scroll-snap-align: start;
  }
  .gallery-track :global(.gallery-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-button {
      transition: none;
    }
  }
</style>
