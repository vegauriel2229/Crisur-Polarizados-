---
import Faq from '../Faq.astro';
import Icon from '../Icon.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import { describeTreatments, type Service } from '../../data/services';

interface Props {
  service: Service;
  whatsappUrl: string;
}

const { service, whatsappUrl } = Astro.props;
---

<section class="details" aria-labelledby="details-title">
  <div class="details-inner">
    <div class="details-head">
      <h2 class="details-title" id="details-title">Qué ganás con la lámina</h2>
      <p class="details-intro">{describeTreatments(service.treatments)}, con la lámina y el tono que mejor van con tu caso.</p>
    </div>
    <ul class="benefits">
      {
        service.benefits.map((benefit) => (
          <li class="benefit">
            <Icon name={benefit.kind} />
            <p>
              <strong>{benefit.title}</strong> {benefit.text}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="questions">
      <h2 class="faq-title">Preguntas frecuentes</h2>
      <Faq items={service.faq} />
      <WhatsAppButton href={whatsappUrl} label={service.ctaLabel} variant="primary" class="faq-cta" />
    </div>
  </div>
</section>

<style>
  .details {
    padding: clamp(4.5rem, 10vw, 8rem) clamp(1rem, 4vw, 2.5rem);
  }
  .details-inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    max-width: 76rem;
    margin: 0 auto;
  }
  @media (min-width: 900px) {
    .details-inner {
      grid-template-columns: 1fr 1fr;
      column-gap: 5rem;
    }
    .details-head {
      grid-column: 1 / -1;
    }
  }
  .details-title,
  .faq-title {
    font-stretch: 118%;
    font-weight: 780;
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
    max-width: 14ch;
  }
  .faq-title {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
    margin-bottom: 1rem;
  }
  .details-intro {
    max-width: 52ch;
    margin-top: 1rem;
    color: var(--color-ink-muted);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.65;
  }
  .benefits {
    display: flex;
    flex-direction: column;
    list-style: none;
  }
  .benefit {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.9rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-muted);
  }
  .benefit :global(.icon) {
    margin-top: 0.15rem;
    color: var(--color-ink);
  }
  .benefit strong {
    color: var(--color-ink);
    font-weight: 620;
  }
  .faq-cta {
    margin-top: 1.75rem;
  }
  @media (max-width: 520px) {
    .faq-cta {
      width: 100%;
    }
  }
</style>
