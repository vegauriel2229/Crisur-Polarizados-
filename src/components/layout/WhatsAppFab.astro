---
import Icon from '../Icon.astro';
import { WHATSAPP_CTA_LABELS } from '../../data/cta';

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<!-- Aparece al dejar atrás la primera pantalla (ahí ya hay un CTA visible). -->
<a class="whatsapp-fab" href={href} target="_blank" rel="noopener noreferrer" data-whatsapp-fab>
  <Icon name="whatsapp" />
  {WHATSAPP_CTA_LABELS.short}<span class="sr-only"> {WHATSAPP_CTA_LABELS.hiddenSuffix}</span>
</a>

<script>
  const fab = document.querySelector<HTMLElement>('[data-whatsapp-fab]');
  if (fab !== null) {
    const update = (): void => {
      fab.dataset['visible'] = String(window.scrollY > window.innerHeight * 0.8);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .whatsapp-fab {
    position: fixed;
    right: calc(1rem + env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 3.25rem;
    padding: 0 1.25rem;
    border-radius: var(--radius-control);
    background: var(--color-cta);
    color: var(--color-on-red);
    font-weight: 650;
    text-decoration: none;
    /* CTA Glow (DESIGN.md) */
    box-shadow:
      0 12px 28px -12px rgba(227, 38, 43, 0.75),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.4s var(--ease-out),
      background-color 0.2s,
      visibility 0s linear 0.4s;
  }
  .whatsapp-fab[data-visible='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .whatsapp-fab:hover {
    background: var(--color-cta-hover);
  }
  .whatsapp-fab[data-visible='true']:active {
    transform: scale(0.98);
  }
  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      transition: none;
    }
  }
</style>
