---
import Icon from '../Icon.astro';
import { WHATSAPP_CTA_LABELS } from '../../data/cta';

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<!-- Visible salvo mientras se ve el hero o la portada (disparador) o el contenido del cierre en servicios (retiro): ahí ya hay un CTA. -->
<a class="whatsapp-fab" href={href} target="_blank" rel="noopener noreferrer" data-whatsapp-fab>
  <Icon name="whatsapp" />
  {WHATSAPP_CTA_LABELS.short}<span class="sr-only"> {WHATSAPP_CTA_LABELS.hiddenSuffix}</span>
</a>

<script>
  const fab = document.querySelector<HTMLElement>('[data-whatsapp-fab]');
  if (fab === null) {
    throw new Error('WhatsAppFab: missing element "[data-whatsapp-fab]"');
  }
  const triggers = document.querySelectorAll<HTMLElement>('[data-whatsapp-fab-trigger]');
  if (triggers.length === 0) {
    throw new Error('WhatsAppFab: missing element "[data-whatsapp-fab-trigger]"');
  }
  const retires = document.querySelectorAll<HTMLElement>('[data-whatsapp-fab-retire]');

  // visible = !disparadorVisible && !retiroActivo: basta que alguna marca cruce el viewport para ocultarlo.
  const intersecting = new Set<Element>();

  // El observer entrega solo las entradas que cambiaron: el estado de todos vive en `intersecting`.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          intersecting.add(entry.target);
        } else {
          intersecting.delete(entry.target);
        }
      }
      fab.dataset['visible'] = String(intersecting.size === 0);
    },
    // La spec de IO cuenta como intersección quedar pegado al borde (0 px); con la raíz achicada 1 px, tocar el borde = 1 px visible.
    { threshold: 0, rootMargin: '-1px 0px' },
  );
  for (const element of [...triggers, ...retires]) {
    observer.observe(element);
  }
</script>

<style>
  .whatsapp-fab {
    position: fixed;
    right: calc(1rem + env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 3.25rem;
    padding: 0 1.25rem;
    border-radius: var(--radius-control);
    background: var(--color-cta);
    color: var(--color-on-red);
    font-weight: 650;
    text-decoration: none;
    /* CTA Glow (DESIGN.md) */
    box-shadow:
      0 12px 28px -12px rgba(227, 38, 43, 0.75),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.4s var(--ease-out),
      background-color 0.2s,
      visibility 0s linear 0.4s;
  }
  .whatsapp-fab[data-visible='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .whatsapp-fab:hover {
    background: var(--color-cta-hover);
  }
  .whatsapp-fab[data-visible='true']:active {
    transform: scale(0.98);
  }
  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      transition: none;
    }
  }
</style>
