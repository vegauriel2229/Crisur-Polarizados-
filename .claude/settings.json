{
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx astro check:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npx prisma validate:*)",
      "Bash(npx prisma format:*)",
      "Bash(npx lighthouse:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(vercel:*)",
      "Bash(ssh:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm create:*)",
      "Bash(npx create-next-app:*)",
      "Bash(npm create astro:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(npm add:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm i:*)",
      "Bash(pnpm remove:*)",
      "Bash(npx shadcn:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npx prisma db seed:*)",
      "Bash(npx vercel:*)",
      "Bash(netlify:*)",
      "Bash(npx netlify:*)",
      "Bash(supabase:*)",
      "Bash(npx supabase:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo create:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(rmdir:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git tag:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma db push --force-reset:*)"
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": false
  }
}
