{"nodes": [{"id": "design", "label": "Design System: Crisur Polarizados", "file_type": "document", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_glass_under_red_light", "label": "Creative North Star: Glass Under Red Light", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L229-L244", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Glass is the only translucent material and red behaves as light, so everything else stays solid, quiet and dark and the single memorable moment (film sliding across a window) reads clearly."}, {"id": "design_red_is_light_rule", "label": "The Red Is Light Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L276", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Red appears only as light or action (backlight, CTA fills/glow, squeegee edge, active-nav underline, focus ring, selection); Action Red fails 4.5:1 as text on graphite."}, {"id": "design_clear_glass_rule", "label": "The Clear Glass Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L278", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unfilmed glass is lighter than its surroundings and shows the interior, so a film visibly darkening, mirroring or frosting the view is what makes it read as film."}, {"id": "design_graphite_not_black_rule", "label": "The Graphite Not Black Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L280", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_film_scene_rule", "label": "The Film Scene Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L282", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client request 2026-09-30: 3D objects are light (pearl car, light concrete facades) against the dark page so a dark film reads at a glance; red floor pool and rim light tie scenes to the home coin glow; no pedestals, lawns, props, silver paint or realistic stock models."}, {"id": "design_one_family_rule", "label": "The One Family Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L309", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hierarchy comes from Archivo's width axis and weight, never a second family; width steps do the work a second family would."}, {"id": "design_fit_to_word_rule", "label": "The Fit-To-Word Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L311", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The display word scales to its own length (--title-chars) and viewport height so the longest service name never clips and the shortest never floats small."}, {"id": "design_glass_only_where_glass_is_rule", "label": "The Glass Only Where Glass Is Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L334", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "backdrop-filter blur is reserved for things that are windows (chooser panes, portal, frost swatch) because the product is glass; containers, menus and sections stay solid."}, {"id": "design_light_behind_glass_rule", "label": "The Light Behind Glass Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L336", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_archivo_variable", "label": "Archivo Variable Typeface", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L286-L306", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_design_tokens", "label": "Design Tokens (src/styles/tokens.css)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L395", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single source for every color, radius, easing and film fill so a value changes in one place."}, {"id": "design_film_materials", "label": "Film Materials (Smoke, Mirror, Frost, Clear Glass)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L265-L273", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_squeegee_film_application", "label": "Squeegee Film Application (Signature Motion)", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L243", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One signature motion, driven by a single 0-1 number (--film in CSS, coverage per pane in 3D), so the system shows privacy instead of naming it."}, {"id": "design_film_variable", "label": "--film Custom Property (0-1)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L378", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registered with @property as a number so CSS transitions interpolate it; script only changes state attributes."}, {"id": "design_coin_logo", "label": "Coin Logo Component", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L368-L369", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client request 2026-09-30: logo on both faces, tossed exactly once on load (2.8s, low hop so it never reaches the header), not interactive, still under reduced motion."}, {"id": "design_service_chooser", "label": "Service Chooser (Home)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L371-L372", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_work_gallery", "label": "Work Gallery (Service Pages)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L374-L375", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Empty state shows the service art with film and an Instagram button instead of stock photos."}, {"id": "design_service_art_with_film", "label": "Service Art with Film (SVG)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L377-L378", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_film_scene", "label": "Film Scene (3D, Service Pages)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L380-L381", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_cover", "label": "Service Cover with Display Giant", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L384", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_chapter_index", "label": "Chapter Index", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L385", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_portal", "label": "Portal Pane to Next Service", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L386", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_loading_counter", "label": "Loading Counter (0-100 %)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L293", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_film_swatches", "label": "Film Swatches (Home)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L388-L389", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_rejected_3d_showroom", "label": "Rejected 3D Showroom (silver paint, pedesta