uthor": null, "contributor": null}, {"id": "docs_sdd_build_time_phone_validation", "label": "Build-Time Phone Validation (fail-fast)", "file_type": "rationale", "source_file": "docs/SDD.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An invalid number breaks the build instead of publishing broken links."}, {"id": "docs_sdd_argentina_whatsapp_9_prefix", "label": "Argentina WhatsApp Mobile '9' Prefix", "file_type": "rationale", "source_file": "docs/SDD.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WhatsApp in Argentina requires 9 after the country code: +54 261 625-6467 is stored as 5492616256467."}, {"id": "docs_sdd_environment_variables", "label": "Environment Variables (Keystatic OAuth, PUBLIC_SITE_URL)", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Secrets live in Vercel, never in the repo; registering a domain only changes PUBLIC_SITE_URL and DNS."}, {"id": "docs_sdd_non_functional_requirements", "label": "Non-Functional Requirements (Lighthouse>=95, LCP<2.5s, WCAG 2.1 AA, mobile-first)", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most traffic arrives from Instagram on mobile."}, {"id": "docs_sdd_local_seo_json_ld", "label": "Local SEO (JSON-LD LocalBusiness, sitemap, Open Graph)", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_sdd_design_tokens", "label": "Design Tokens (src/styles/tokens.css)", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single file of custom properties to change typography or palette; self-hosted fonts, no Google Fonts."}, {"id": "docs_sdd_brand_palette", "label": "Brand Palette (tinted-glass graphite + logo red)", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a79.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Background evokes tinted glass (bluish graphite, not flat black); logo red #e3262b used as light and CTA; contrast ratios chosen for WCAG AA."}, {"id": "docs_sdd_archivo_variable_typography", "label": "Archivo Variable Typography", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a79.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One family, two widths: wide heavy display for automotive language, normal width for text."}, {"id": "docs_sdd_showroom_design_principles", "label": "Showroom Design Principles (one memorable moment, glass is the theme, red is light, nothing covers the product)", "file_type": "rationale", "source_file": "docs/SDD.md", "source_location": "\u00a79.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 3D showroom is the only memorable moment; glass is rendered physically (PBR) rather than via UI glassmorphism; generic defaults (uppercase eyebrows, separators, arrows, thin serif) removed."}, {"id": "docs_sdd_showroom_3d_hero", "label": "Showroom 3D Hero", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a79.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the 2D switcher; copy on top, showroom zone below, WebGL canvas covers the whole stage."}, {"id": "docs_sdd_service_roulette", "label": "Service Roulette (locales, autos, hogares ring at 120 deg)", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a79.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed cyclic order; selecting a lateral diorama rotates the ring the shortest way."}, {"id": "docs_sdd_view_offset_framing", "label": "Framing Zone via setViewOffset", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a79.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Camera frames the featured diorama inside the showroom zone so it never sits under the text or CTA."}, {"id": "docs_sdd_showroom_contract", "label": "Showroom API Contract (createShowroom/Showroom/ShowroomOptions)", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a79.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_sdd_hero_animation_timeline", "label": "Hero Animation Timeline (entry, change, idle, reduced-motion)", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a79.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time-based (not frame-based) animation so it finishes on time on slow devices; prefers-reduced-motion disables entry/idle and makes changes instant."}, {"id": "docs_sdd_hero_accessibility_interaction", "label": "Hero Interaction & Accessibility (keyboard, swipe, aria-live, #hash deep link)", "file_type": "concept", "source_file": "docs/SDD.md", "source_location": "\u00a79.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canvas is aria-hidden; information lives in text announced via aria-live polite."}, {"id": "docs_sdd_deferred_threejs_loading", "label": "Deferred Three.js Chunk Loading", "file_type": "rationale", "source_file": "docs/SDD.md", "source_location": "\u00a79.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dynamic import in requestIdleCallback after first